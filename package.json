{
  "name": "music-genre-classifier",
  "scripts": {
    "frontend": "bun --cwd frontend dev",
    "backend": "cd backend && . venv/bin/activate && python main.py",
    "build": "bun --cwd frontend build",
    "start": "bun --cwd frontend start",
    "lint": "bun --cwd frontend lint",
    "format": "bunx prettier --write \"frontend/**/*.{ts,tsx,json,md}\" && cd backend && . venv/bin/activate && black .",
    "dev": "concurrently -n \"next,fastapi\" -c \"cyan,magenta\" \"bun frontend\" \"bun backend\""
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4"
  }
}
